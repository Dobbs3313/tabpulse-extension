{
  "manifest_version": 3,
  "name": "TabPulse — Fast Multi-Window Tab Manager",
  "short_name": "TabPulse",
  "description": "Zero-flicker multi-window Chrome tab manager with instant fuzzy search, active-tab auto-scroll, deduplication, and auto-grouping.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TabPulse",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Open TabPulse instant search"
    }
  }
}
